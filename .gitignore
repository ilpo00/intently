# dependencies
node_modules/

# next.js
.next/
out/
next-env.d.ts

# testing
coverage/

# production
build/
dist/

# misc
.DS_Store
*.pem
*.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — never commit secrets
.env*.local
.env.local

# AI dev-mode budget tracker (per-day request counts, dev-only)
.ai-budget.json

# Raw datasets (e.g. Kaggle fashion-product-images) — far too large to commit.
# Only the curated subset the app actually serves is committed, under
# intently/public/catalog/.
/data/

# Enrichment layer · file-backed vector store (dev / no-supabase mode).
# Regenerated on every "Sync from PIM" in /admin/enrichment.
intently/.enrichment/

# Supabase CLI scratch state (project-ref, versions, pooler url).
# Regenerated by `supabase link`. Per-machine — never commit.
intently/supabase/.temp/

# Medusa PIM workspace
pim/.env
pim/node_modules/
pim/.medusa/
pim/dist/
pim/build/

# Application logs (dev-only)
.logs/

# vercel
.vercel

# obsidian (UI state — vault config is committed; per-session workspace files are not)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspaces.json
.obsidian/graph.json
.obsidian/cache

# The canonical Obsidian vault is the repo-root .obsidian/. Opening wiki/ on its
# own spawns a spurious nested vault — don't track it.
wiki/.obsidian/

# claude code transient worktrees
.claude/worktrees/

# Agent skills installed via `npx skills install`.
# Lockfile (skills-lock.json) is committed; the installed content is not —
# anyone cloning runs `npx skills install` to materialise the skills.
.agents/
.claude/skills/

# Preview MCP dev-server config — user-specific (sources ~/.zshenv etc).
# If you want a committed dev convenience, add dotenv-cli to package.json
# and set `dev: "dotenv -e .env.local -- next dev"` instead.
.claude/launch.json

# Assembled video (large binaries; regenerated by npm run video:assemble)
docs/video/out/

# Product photos are H&M images served by the live demo; never committed here
intently/public/catalog/*.webp
storefront/public/catalog/*.webp
