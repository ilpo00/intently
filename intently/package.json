{
  "name": "intently",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:localsetup": "bash scripts/dev-localsetup.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "test:ci": "jest --ci --coverage",
    "env:init": "node scripts/env-init.mjs",
    "ai:budget": "node scripts/ai-budget.mjs",
    "ai:budget:reset": "node scripts/ai-budget.mjs reset",
    "logs": "node scripts/logs-tail.mjs",
    "logs:raw": "node scripts/logs-tail.mjs --raw",
    "logs:clear": "node scripts/logs-tail.mjs --clear",
    "check:service-role": "node scripts/check-service-role.mjs",
    "admin:login-link": "node scripts/admin-login-link.mjs",
    "prune:branches": "bash scripts/prune-local-branches.sh",
    "eval": "jest --testMatch '<rootDir>/scripts/**/*.eval.ts'",
    "eval:tailor": "jest --testMatch '<rootDir>/scripts/tailor-eval.eval.ts'",
    "eval:parse": "jest --testMatch '<rootDir>/scripts/parse-eval.eval.ts'",
    "eval:scorecard": "jest --testMatch '<rootDir>/scripts/scorecard.eval.ts'",
    "video:record": "playwright test -c e2e/video/playwright.config.ts",
    "video:assemble": "node scripts/video/assemble.mjs",
    "record:probe-fixtures": "PROBE_RECORD=1 NEXT_PUBLIC_CATALOG=vision jest --testMatch '<rootDir>/scripts/probe-fixtures.record.ts'"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@xenova/transformers": "^2.17.2",
    "ai": "^3.2.22",
    "clsx": "^2.1.1",
    "next": "16.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29",
    "@types/node": "^20",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.2",
    "autoprefixer": "^10.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "jest": "^29",
    "jest-environment-jsdom": "^29",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "securityNotes": {
    "next": "Pinned to 16.2.3 — minimum patched version for CVE-2025-66478 (React2Shell RCE, CVSS 10.0). Do not downgrade below 16.0.7 / 15.3.6 / 15.2.6.",
    "react": "Pinned to 19.2.3 — minimum patched version for CVE-2025-55182. Do not float with ^ until React 19.3+ confirms no regression."
  }
