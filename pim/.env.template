# ─────────────────────────────────────────────
# Intently PIM (Medusa v2) · local env template
# Copy to `.env` — .env is gitignored.
#
# setup.sh will substitute DATABASE_URL with the local one it created.
# ─────────────────────────────────────────────

# Postgres. Set by setup.sh on first run.
DATABASE_URL=postgres://localhost:5432/intently_pim

# Secrets — change before any non-local deploy.
JWT_SECRET=change-me-jwt-secret
COOKIE_SECRET=change-me-cookie-secret

# CORS. Intently dev server is :3000.
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:3000
AUTH_CORS=http://localhost:9000,http://localhost:3000

# Admin user created by the seed script.
ADMIN_EMAIL=admin@intently.local
ADMIN_PASSWORD=supersecret

# Redis (optional in dev). Uncomment to use.
# REDIS_URL=redis://localhost:6379

# Port (defaults to 9000).
# PORT=9000
